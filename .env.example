# Públicas (seguras en el navegador; la seguridad la da RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Pruebas gratuitas con Gemini: IA_PROVIDER=gemini, GEMINI_API_KEY=... y los modelos (ver README)
# IA_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL_SIMPLE=
# GEMINI_MODEL_COMPLEX=
APP_URL=https://tu-dominio.com

# Solo para ver la app con datos ficticios, sin Supabase (nunca en producción)
# NEXT_PUBLIC_DEMO=1

# Modelos de IA (opcional). Para PRUEBAS baratas, todo con el modelo pequeño:
# CHAT_MODEL_SIMPLE=claude-haiku-5-5
# CHAT_MODEL_COMPLEX=claude-haiku-5-5
# DOC_MODEL=claude-haiku-5-5
# En producción déjalo vacío: consultas con Haiku; registros y lectura de documentos con Sonnet.

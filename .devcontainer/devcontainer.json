{
  "name": "Control de Fincas (demo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "containerEnv": { "NEXT_PUBLIC_DEMO": "1" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Demo Control de Fincas", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm run dev"
}
